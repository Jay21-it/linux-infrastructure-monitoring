# Copy to /etc/monitoring-webhook.env and replace example values.
# Generate a high-entropy token with: openssl rand -hex 32
WEBHOOK_TOKEN=REPLACE_WITH_A_RANDOM_SECRET
WEBHOOK_LISTEN_HOST=127.0.0.1
WEBHOOK_LISTEN_PORT=5001
MAX_BODY_BYTES=1048576
LOG_LEVEL=INFO
ZABBIX_SERVER_ADDR=127.0.0.1
ZABBIX_SERVER_PORT=10051
ZABBIX_HOST=linux-client01
ZABBIX_ITEM_KEY=prometheus.alert.state
ZABBIX_SENDER_BIN=/usr/bin/zabbix_sender
